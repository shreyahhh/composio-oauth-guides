# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Neon Postgres connection string (pooled, HTTP-compatible).
# Get it from the Neon dashboard -> your project -> Connection Details.
DATABASE_URL=

# Google AI Studio API key (Gemini API free tier).
# Get it from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the model id without a code change. Defaults to the
# floating "latest" alias so this doesn't go stale as Google ships new models.
# Check your own AI Studio console for current free-tier rate limits before
# relying on a specific number -- Google no longer publishes a universal table.
GEMINI_MODEL=gemini-flash-latest

# Composio API key (free plan). Get it from https://app.composio.dev
COMPOSIO_API_KEY=
