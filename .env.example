# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Neon Postgres connection string (pooled, HTTP-compatible).
# Get it from the Neon dashboard -> your project -> Connect.
DATABASE_URL=

# Groq API key (free tier -- rate-limited, not credit-limited, no card ever
# required). Get it from https://console.groq.com/keys
GROQ_API_KEY=

# Optional: override the model id without a code change. Defaults to
# openai/gpt-oss-120b. Groq's catalog turns over fast -- verify against
# GET https://api.groq.com/openai/v1/models with your own key before
# trusting this default, or check console.groq.com/docs/models.
GROQ_MODEL=openai/gpt-oss-120b

# Tavily search API key (free tier: 1,000 credits/month, no card required).
# Used for the Research/Resolve pipeline steps' web search, since Groq's own
# search tool is a paid add-on. Get it from https://app.tavily.com
TAVILY_API_KEY=

# Composio API key (free plan). Get it from https://app.composio.dev --
# switch the dashboard to "Platform" mode first, then Settings -> Project
# Settings -> API Keys. (Not the "For You" mode's MCP consumer key.)
COMPOSIO_API_KEY=
